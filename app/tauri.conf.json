{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organizador",
  "version": "0.1.0",
  "identifier": "com.pichau.organizador",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Organizador",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}